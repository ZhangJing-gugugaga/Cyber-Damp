{
  "name": "cyber-damp",
  "version": "0.1.11",
  "description": "回南天 Cyber Damp - 桌面文件受潮发霉/拉绳晾晒/蘑菇养成的数字家务模拟器 MVP",
  "main": "dist/main/index.js",
  "author": "ZhangJing-gugugaga",
  "contributors": [
    "2584666910@qq.com"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "dev": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "test:constants": "node --test scripts/check-shared.mjs",
    "test:world": "tsc -p tsconfig.test.json && node --test scripts/test-world.mjs",
    "qa:cdp": "node scripts/qa-cdp.mjs",
    "qa:window": "node scripts/qa-window.mjs",
    "qa:dox": "node scripts/check-dox.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "koffi": "^3.3.3",
    "lucide": "1.58.0",
    "pixi-filters": "6.1.5",
    "pixi.js": "8.21.0"
  },
  "build": {
    "appId": "com.moonzj.cyberdamp",
    "productName": "Cyber Damp",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/renderer/public/brand/rain-mushroom.ico",
      "target": "portable"
    },
    "directories": {
      "output": "release"
    }
  }
}
