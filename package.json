{
  "name": "cyber-damp",
  "version": "0.1.25",
  "description": "回南天 Cyber Damp - 原生桌面图标天气变化与轻量护理",
  "main": "dist/main/index.js",
  "author": "ZhangJing-gugugaga",
  "contributors": [
    "2584666910@qq.com"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "dev": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --config.electronDist=node_modules/electron/dist",
    "test:world": "tsc -p tsconfig.test.json && node --test scripts/test-native-events.mjs scripts/test-native-care.mjs",
    "qa:dox": "node scripts/check-dox.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "china-division": "^2.7.0",
    "koffi": "^3.3.3",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.moonzj.cyberdamp",
    "productName": "Cyber Damp",
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/shared/**/*",
      "dist/world/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/renderer/public/brand/rain-mushroom.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "output": "release"
    }
  }
}
