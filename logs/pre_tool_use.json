      "content": "/**\n * shared \u705e\u509e\u654b\u9410\u89c4\u6e80\u59ca\u4f34\u7359\u7487\u4f8a\u7d19node:test\u951b\u5861n * \u95c3\u63d2\u591f\u7459\u591b\u7d30\u6fb6\u5d87\u757b\u934f\udcac\u5bee\u5fd3\u7584\u7ee0\u6940\udc80\udcbc + \u93c2\udcad\u7477\udc80\u5a67\u612e\u721c\u934f\u62bd\u656d\u7039\u6c2b\u7b9f\u701b\u6a3a\u6e6a\n * \u6769\u612f\udca1\u5c8b\u7d30npm run test:constants\n */\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { fileURLToPath } from 'node:url';\nimport { dirname, join } from 'node:path';\n\nconst root = join(dirname(fileURLToPath(import.meta.url)), '..');\n\n/** \u6d93\udc8e src/shared/constants.ts \u95ab\u612c\u74e7\u7035\u5f52\u7d88\u9428\u52eb\u53d5\u5bee\u5fd3\udca4\u5d87\u757b\u951b\u5758b=sizeBytes/1024 \u6d5c\u5c83\u7e58\u9352\u8dfa\u5f5b\u5bf0\u52f6\u7d1a */\nfunction sizeToMass(sizeBytes) {\n  const kb = Math.max(sizeBytes / 1024, 1);\n  return 0.4 + Math.log10(kb) * 0.8;\n}\n\ntest('sizeToMass \u7039\u70b5\u757b\u95bf\u6c31\u5063\u6d93\u5ea2\u6783\u5997\uff44\u88b1\u6d63\u5d85\u76ac\u93c1\u9881\u7af4\u9477\udcb4', () => {\n  const KB = 1024;\n  const anchors = [\n    [1 * KB, '0.40'],\n    [10 * KB, '1.20'],\n    [1 * KB * KB, '2.81'],\n    [1 * KB * KB * KB, '5.22'],   // 5.2165 \u922b\udc92 5.22\u951b\u581f\u7066\u93cb\u52eb\u7b00\u6dc7\udcae\u59dd\uff4f\u7d1d\u7ec2\u4f78\u5553 5.20\u951b\u5861n    [20 * KB * KB * KB, '6.26'],  // 6.2573 \u922b\udc92 6.26\n    [24 * KB * KB * KB, '6.32'],  // 6.3207 \u922b\udc92 6.32\n  ];\n  for (const [bytes, expected] of anchors) {\n    assert.equal(sizeToMass(bytes).toFixed(2), expected, `sizeToMass(${bytes}) \u6434\u65be\u8d1f ${expected}`);\n  }\n});\n\ntest('5GB vs 25GB \u7490\u3129\u567a\u9351\u72b1\u7bae\u93c3\u72b2\u6a0a\u951b\u5823\u7609\u93c4\u5ea1\u7a7f\u93c2\udcad\u8e47\u5474\u300f\u93b8\u590a\u74e7\u947a\u509a\u57bd\u951b\udc89', () => {\n  const diff = Math.abs(sizeToMass(5 * 1024 ** 3) - sizeToMass(25 * 1024 ** 3));\n  assert.ok(diff < 0.6, `5GB/25GB \u7490\u3129\u567a\u5bb8\udcae\u6434\udc94 <0.6\u951b\u5c7d\u7584\u7ee0\udc97 ${diff.toFixed(3)}`);\n});\n\ntest('\u5a67\u612e\u721c\u935a\udcab\u934f\u62bd\u656d\u7039\u6c2b\u7b9f', () => {\n  const c = readFileSync(join(root, 'src/shared/constants.ts'), 'utf8');\n  assert.match(c, /GB = 1024 \\*\\* 3/);\n  assert.match(c, /0\\.4 \\+ Math\\.log10\\(kb\\) \\* 0\\.8/);\n  assert.match(c, /'rope-1': 5 \\* GB/);\n  assert.match(c, /'rope-2': 25 \\* GB/);\n  assert.match(c, /'rope-3': 100 \\* GB/);\n  const s = readFileSync(join(root, 'src/shared/save/save-schema.ts'), 'utf8');\n  assert.match(s, /schemaVersion !== 1/);\n});\n",
